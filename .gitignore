# ═══════════════════════════════════════════
#  Vynas — Git Ignore (Merged with Vite/SPA)
# ═══════════════════════════════════════════

# Backups and archives
_backup/
*.zip
node.zip

# Media (large files)
img/videoplayback.mp4

# Python cache
__pycache__/
*.pyc

# Entorno y Logs
.env
*.local
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caché de datos (generado por nasa_proxy.php)
data/cache/

# Dev artifacts and build outputs
.implementation-state.md
node_modules/
dist/
dist-ssr/
.DS_Store
Thumbs.db

# Local tools
.tools/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
